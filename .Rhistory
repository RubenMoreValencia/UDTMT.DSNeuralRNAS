library(Lexico.DSNeuralRNAS)
library(PLN.DSNeuralRNAS)
library(UDTMT.DSNeuralRNAS)
dic <- PLN.DSNeuralRNAS::cargar_diccionarios_pln()
probar_ejemplo_udtmt <- function(texto, preguntas, dic) {
cat("\n====================================================\n")
cat("TEXTO:\n")
cat(texto, "\n")
for (p in preguntas) {
cat("\n----------------------------------------------------\n")
cat("PREGUNTA:", p, "\n")
u <- crear_udtmt_ds(
texto = texto,
pregunta = p,
diccionarios = dic
)
r <- resumir_udtmt_ds(u)
rel <- resumir_relaciones_udtmt_ds(u)
resp_rel <- responder_por_relaciones_udtmt_ds(u)
cat("ARQUITECTURA:", r$arquitectura, "\n")
cat("INTENCION:", r$intencion, "\n")
cat("RESPUESTA UDT-MT:\n")
cat(r$respuesta, "\n\n")
cat("LECTURA RELACIONAL:\n")
cat(rel$lectura, "\n\n")
cat("RELACIONES:\n")
print(rel$relaciones)
cat("\nRESPUESTA POR RELACIONES:\n")
cat(resp_rel, "\n")
}
}
texto1 <- "
La perdida disminuye despues del ajuste.
El sistema mejora con la revision.
La evidencia muestra una trayectoria estable.
"
preguntas1 <- c(
"Que trayectoria presenta el texto?",
"Que cambia en el texto?",
"Que evidencia textual sostiene la respuesta?",
"Que relaciones aparecen en el texto?"
)
probar_ejemplo_udtmt(texto1, preguntas1, dic)
