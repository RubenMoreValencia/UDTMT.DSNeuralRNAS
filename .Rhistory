probar_relaciones_udtmt <- function(texto, preguntas, dic) {
for (p in preguntas) {
cat("\n====================================================\n")
cat("PREGUNTA:", p, "\n")
u <- crear_udtmt_ds(
texto = texto,
pregunta = p,
diccionarios = dic
)
r <- resumir_udtmt_ds(u)
rel <- resumir_relaciones_udtmt_ds(u)
resp_rel <- responder_por_relaciones_udtmt_ds(u)
cat("ARQUITECTURA:", r$arquitectura, "\n")
cat("INTENCION:", r$intencion, "\n")
cat("RESPUESTA UDT-MT:", r$respuesta, "\n\n")
cat("LECTURA RELACIONAL:\n")
cat(rel$lectura, "\n\n")
cat("RELACIONES:\n")
print(rel$relaciones)
cat("\nRESPUESTA POR RELACIONES:\n")
cat(resp_rel, "\n")
}
}
texto_causalidad <- "
La perdida aumenta porque el control falla.
El ajuste reduce el error y mejora el sistema.
"
preguntas_causalidad <- c(
"Que causa el cambio?",
"Que cambia en el texto?",
"Que trayectoria presenta el texto?"
)
probar_relaciones_udtmt(texto_causalidad, preguntas_causalidad, dic)
texto_contraste <- "
La memoria conserva la evidencia.
Pero el ruido altera la trayectoria.
Aunque el sistema mejora, la frontera persiste.
"
preguntas_contraste <- c(
"Que contraste aparece?",
"Que cambia en el texto?",
"Que evidencia textual sostiene la respuesta?"
)
probar_relaciones_udtmt(texto_contraste, preguntas_contraste, dic)
texto_naturaleza <- "
La lluvia alimenta el rio.
El viento mueve la pradera.
La tierra conserva la humedad durante el dia.
"
preguntas_naturaleza <- c(
"Que elementos de naturaleza aparecen?",
"Que palabras funcionan como contexto?",
"Que relaciones aparecen en el texto?"
)
probar_relaciones_udtmt(texto_naturaleza, preguntas_naturaleza, dic)
texto_memoria <- "
El sosiego calma la memoria.
La tristeza activa una señal antigua.
La esperanza transforma el recuerdo.
"
preguntas_memoria <- c(
"Que emocion domina en el texto?",
"Que palabras funcionan como memoria?",
"Que cambia en el texto?"
)
probar_relaciones_udtmt(texto_memoria, preguntas_memoria, dic)
texto_emergencia <- "
El metacauce organiza la memoria del sistema.
La señal intermedia activa una frontera nueva.
El aprendizaje deriva hacia una lectura emergente.
"
preguntas_emergencia <- c(
"Que palabras no estan registradas?",
"Que trayectoria presenta el texto?",
"Que relaciones aparecen en el texto?"
)
probar_relaciones_udtmt(texto_emergencia, preguntas_emergencia, dic)
